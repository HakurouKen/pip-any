{
  "name": "pip-any",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/build.ts --watch",
    "build": "tsx scripts/build.ts",
    "pack-crx": "pnpm build && tsx scripts/pack-crx.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "happy-dom": "^20.0.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.24.0"
}
